# Template only. Actual file: /etc/gpt-dot-work/service.env, private and NOT in Git.
NODE_ENV=production
WORKSPACE_OWNER_NAME=Owner
# Generate a password hash on your trusted terminal, never paste a real password in chat.
WORKSPACE_OWNER_PASSWORD_HASH=
WORKSPACE_PUBLIC_ORIGIN=https://workspace.example.com
WORKSPACE_HOST=127.0.0.1
WORKSPACE_PORT=4318
WORKSPACE_DB_PATH=/var/lib/gpt-dot-work/tasks.sqlite
WORKSPACE_STATIC_DIR=/srv/gpt-dot-work/current/dist
WORKSPACE_SESSION_TTL_SECONDS=43200
WORKSPACE_SESSION_IDLE_SECONDS=3600
WORKSPACE_RUNTIME=disabled
WORKSPACE_POLL_MS=60000
WORKSPACE_LEASE_MS=120000
WORKSPACE_CONCURRENCY=2
# Bearer automation/approval credentials intentionally absent. Owner session mode suffices.

# Set by the existing deployment orchestrator to the activated commit SHA.
WORKSPACE_RELEASE=

# Optional exact loopback peer, only AFTER verifying the proxy overwrites
# X-Workspace-Client-IP from its trusted socket address. Leave empty otherwise.
WORKSPACE_TRUST_PROXY=
