# Separate virtual host only; never replace an existing/default/bug-system server block.
# Replace example domain and existing certificate paths after operator review.
# TLS certificates must already be issued through an approved administrative process.
server {
    listen 80;
    server_name workspace.example.com;
    return 308 https://workspace.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name workspace.example.com;
    ssl_certificate /etc/ssl/workspace.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/workspace.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=15552000" always;
    location / {
        proxy_pass http://127.0.0.1:4318;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Always OVERWRITE this dedicated header; never forward an inherited value.
        # Verify any existing nginx real_ip configuration before enabling app proxy trust.
        proxy_set_header X-Workspace-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    # Decide private access-log storage/retention before enabling request logs.
    access_log off;
}
