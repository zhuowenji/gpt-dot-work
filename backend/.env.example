# Copy to a private file OUTSIDE the repository. Set permissions 0600.
# No real credentials are included. See README.md for the no-echo hash workflow.
NODE_ENV=production
WORKSPACE_OWNER_PASSWORD_HASH=
WORKSPACE_OWNER_NAME=Owner
# Exact public HTTPS origin; no path or trailing slash.
WORKSPACE_PUBLIC_ORIGIN=https://workspace.example.com
# Must remain loopback-only in production, behind your existing HTTPS proxy.
WORKSPACE_HOST=127.0.0.1
WORKSPACE_PORT=4318
# Absolute private persistent LOCAL disk path, outside checkout AND public directory.
# Default: $XDG_STATE_HOME/gpt-dot-work/tasks.sqlite, or ~/.local/state/...
WORKSPACE_DB_PATH=
# Absolute path to built dist/. Empty uses the repository's dist/.
WORKSPACE_STATIC_DIR=
WORKSPACE_SESSION_TTL_SECONDS=43200
WORKSPACE_SESSION_IDLE_SECONDS=3600
# Optional non-secret release ID visible in /health; usually the Git commit SHA.
WORKSPACE_RELEASE=
# Optional independent tokens for machine clients ONLY. Never put these in browser JS.
# Owner session authentication does not need bearer tokens.
WORKSPACE_API_TOKEN=
WORKSPACE_APPROVAL_TOKEN=
WORKSPACE_POLL_MS=60000
WORKSPACE_LEASE_MS=120000
WORKSPACE_CONCURRENCY=2
# disabled (safe default) or explicitly demo (deterministic demo.echo/demo.approval only).
WORKSPACE_RUNTIME=disabled
# Legacy bearer-client browser origin. For owner mode leave empty (same-origin only).
WORKSPACE_ALLOWED_ORIGIN=
