# Generate independent random values locally. Never put tokens in browser code or commit them.
WORKSPACE_API_TOKEN=
WORKSPACE_APPROVAL_TOKEN=
WORKSPACE_HOST=127.0.0.1
WORKSPACE_PORT=4318
# Optional absolute path on a private persistent LOCAL disk, outside your checkout.
# Default: $XDG_STATE_HOME/gpt-dot-work/tasks.sqlite, or ~/.local/state/...
WORKSPACE_DB_PATH=
WORKSPACE_POLL_MS=60000
WORKSPACE_LEASE_MS=120000
WORKSPACE_CONCURRENCY=2
# disabled (safe default) or demo (only deterministic demo.echo / demo.approval).
WORKSPACE_RUNTIME=disabled
# Optional exact browser origin. Empty means no cross-origin browser access.
WORKSPACE_ALLOWED_ORIGIN=
